BLOB_COVER_READ_WRITE_TOKEN=""

MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""
ALLOW_PAYMENT_SIMULATION="false"
GOOGLE_MAPS_API_KEY=""
GOOGLE_BOOKS_API_KEY=""
