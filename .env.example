# Configuração para PostgreSQL e integrações reais. Para demonstração: npm run demo.
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/biblioconnect"
JWT_SECRET="SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_DE_PELO_MENOS_32_CARACTERES"
AUTH_SECRET="SUBSTITUA_POR_OUTRO_SEGREDO_ALEATORIO_DE_PELO_MENOS_32_CARACTERES"
CRON_SECRET="SUBSTITUA_POR_OUTRO_SEGREDO_ALEATORIO_DE_PELO_MENOS_32_CARACTERES"
NODE_ENV="development"
PORT="3000"
BACKEND_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:5173"
ADMIN_EMAIL="admin@biblioconnect.com"
ADMIN_PASSWORD="DEFINA_UMA_SENHA_FORTE"

# gmail, smtp, resend ou file (somente desenvolvimento, salva HTML em .emails).
EMAIL_PROVIDER="gmail"
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM=""
EMAIL_HOST=""
EMAIL_PORT="587"
EMAIL_SECURE="false"
RESEND_API_KEY=""

GOOGLE_CLIENT_ID=""
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# local no desenvolvimento; blob em produção. Retratos privados e capas públicas.
MEDIA_STORAGE="local"
BLOB_AVATAR_STORE_ID=""
BLOB_COVER_STORE_ID=""
# Alternativa ao OIDC do projeto; nunca expor estes tokens no frontend.
